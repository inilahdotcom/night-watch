{
  "name": "night-watch",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "cd apps/web && bun run dev",
    "dev:worker": "cd apps/worker && bun run dev",
    "typecheck": "cd packages/core && bun run typecheck && cd ../../apps/worker && bun run typecheck && cd ../web && bun run typecheck",
    "test": "cd packages/core && bun run test",
    "db:generate": "cd packages/core && bun run db:generate",
    "db:migrate": "cd packages/core && bun run db:migrate",
    "db:seed": "cd packages/core && bun run db:seed",
    "db:demo": "cd packages/core && bun run db:demo",
    "db:collect": "cd packages/core && bun run db:collect",
    "alert:test": "cd packages/core && bun run alert:test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint": "eslint .",
    "audit:licenses": "bun scripts/license-audit.ts",
    "audit:licenses:md": "bun scripts/license-audit.ts --markdown"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "latest",
    "@types/bun": "latest",
    "@types/node": "^22",
    "eslint": "^9",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6",
    "vitest": "^4"
  }
}
